FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY ["MamoScope_API/MamoScope_API.csproj", "MamoScope_API/"]
COPY ["Application/Application.csproj", "Application/"]
COPY ["Infrastructure/Infrastructure.csproj", "Infrastructure/"]
COPY ["Domain/Domain.csproj", "Domain/"]

RUN dotnet restore "MamoScope_API/MamoScope_API.csproj"

COPY . .

WORKDIR "/src/MamoScope_API"
RUN dotnet build "MamoScope_API.csproj" -c Release -o /app/build

FROM build AS publish
RUN dotnet publish "MamoScope_API.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app

COPY --from=publish /app/publish .

ENTRYPOINT ["dotnet", "MamoScope_API.dll"]