<Application x:Class="MaMoScope_.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MaMoScope_"
             xmlns:conv="clr-namespace:MaMoScope_.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.xaml"/>
                <ResourceDictionary Source="Resources/TextStyles.xaml"/>
                <ResourceDictionary Source="Resources/Inputs.xaml"/>
                <ResourceDictionary Source="Resources/Buttons.xaml"/>
                <ResourceDictionary Source="Resources/NavigationBar.xaml"/>
                
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToResultConverter x:Key="BoolToResultConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
