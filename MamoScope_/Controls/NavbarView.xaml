<UserControl x:Class="MaMoScope_.Controls.NavbarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MaMoScope_.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="260">

    <Grid Background="{StaticResource PrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        
        <StackPanel Grid.Row="0" Margin="24,28,24,20">
            <TextBlock Text="MamoScope" FontSize="22" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Test Sistemi" FontSize="12" Foreground="#8FA8C9" Margin="0,2,0,0"/>
        </StackPanel>

        <Rectangle Grid.Row="0" VerticalAlignment="Bottom" Height="1" 
                   Fill="#2B5A94" Margin="24,0,24,12"/>

        
        <StackPanel Grid.Row="1">
            <RadioButton Content="Test" Style="{StaticResource NavButton}" 
                         Command="{Binding OpenTestCommand}" IsChecked="True"/>
            <RadioButton Content="Geçmiş Kayıtlar" Style="{StaticResource NavButton}" 
                         Command="{Binding OpenPastRecordsCommand}"/>
        </StackPanel>

       
        <StackPanel Grid.Row="3" Margin="24,0,24,20">
            <Rectangle Height="1" Fill="#2B5A94" Margin="0,0,0,12"/>
            <TextBlock Text="v1.0.0" FontSize="11" Foreground="#6E88AA"/>
        </StackPanel>
    </Grid>
</UserControl>