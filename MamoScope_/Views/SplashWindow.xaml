        <TextBlock Text="Bağlanıyor..." Foreground="White" FontSize="16" Margin="0,0,0,10" HorizontalAlignment="Center"/>
        <ProgressBar IsIndeterminate="True" Width="200" Height="10"/>
    </StackPanel>
</Window>